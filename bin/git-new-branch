#!/bin/bash

# Git custom command: git new-branch
# Creates a new branch with format: ${gituser}/${ticket_number}/${description}

set -e

# Get git user from config
gituser=$(git config user.githubusername 2>/dev/null)

# Check if gituser is configured
if [ -z "$gituser" ]; then
    echo "Error: git config user.githubusername is not set."
    echo "Please run: git config --global user.githubusername \"your-username\""
    exit 1
fi

# Prompt for ticket number
echo -n "Enter ticket number: "
read -r ticket_number

if [ -z "$ticket_number" ]; then
    echo "Error: Ticket number cannot be empty."
    exit 1
fi

# Prompt for description
echo -n "Enter branch description: "
read -r short_description

if [ -z "$short_description" ]; then
    echo "Error: Description cannot be empty."
    exit 1
fi

# Prompt for long description
echo -n "Enter long description (optional): "
read -r long_description

# Clean up description (replace spaces with hyphens, remove special characters)
# macOS-compatible version using multiple sed commands instead of complex regex
clean_description=$(echo "$short_description" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//')

# Create branch name
branch_name="${gituser}/${ticket_number}/${clean_description}"

echo "Creating branch: $branch_name"

# Switch to main and pull latest
git checkout main
git pull origin main

# Create and switch to new branch
git checkout -b "$branch_name"

# Make initial empty commit with formatted message
# Create Jira link
jira_link="[${ticket_number}](https://jetblueairways.atlassian.net/browse/${ticket_number})"

# Build commit message
if [ -n "$long_description" ]; then
    commit_message="${ticket_number} - ${short_description}

${jira_link}

${long_description}"
else
    commit_message="${ticket_number} - ${short_description}

${jira_link}"
fi

git commit --allow-empty -m "$commit_message"

echo "Successfully created and switched to branch: $branch_name"
