#!/bin/bash

# Git custom command: git new-branch
# Creates a new branch with format: ${gituser}/${ticket_number}/${description}

set -e

# Get git user from config
gituser=$(git config user.githubusername 2>/dev/null)

# Check if gituser is configured
if [ -z "$gituser" ]; then
    echo "Error: git config user.githubusername is not set."
    echo "Please run: git config --global user.githubusername \"your-username\""
    exit 1
fi

# Prompt for ticket number(s)
echo -n "Enter ticket number(s) (comma-separated): "
read -r ticket_input

if [ -z "$ticket_input" ]; then
    echo "Error: Ticket number cannot be empty."
    exit 1
fi

# Parse ticket numbers
IFS=',' read -ra ticket_array <<< "$ticket_input"
ticket_numbers=()
for ticket in "${ticket_array[@]}"; do
    # Trim whitespace
    trimmed_ticket=$(echo "$ticket" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -n "$trimmed_ticket" ]; then
        ticket_numbers+=("$trimmed_ticket")
    fi
done

# Get first ticket for branch naming
first_ticket="${ticket_numbers[0]}"

# Determine title format
if [ ${#ticket_numbers[@]} -eq 1 ]; then
    title_prefix="${first_ticket} - "
elif [ ${#ticket_numbers[@]} -eq 2 ]; then
    title_prefix="${ticket_numbers[0]}, ${ticket_numbers[1]} - "
else
    title_prefix="${ticket_numbers[0]}, ${ticket_numbers[1]}, ... - "
fi

# Prompt for description
echo -n "Enter branch description: "
read -r short_description

if [ -z "$short_description" ]; then
    echo "Error: Description cannot be empty."
    exit 1
fi

# Ask if user wants to add a long description
echo -n "Add a long description? (y/N): "
read -r add_long_desc

long_description=""
if [[ "$add_long_desc" =~ ^[Yy]$ ]]; then
    # Prompt for long description using Git's editor
    echo "Opening editor for long description..."
    temp_file=$(mktemp)

    # Create template content
    cat > "$temp_file" << EOF
# Enter your long description for ticket(s): ${ticket_input}
# Lines starting with # will be ignored and removed
#
# Ticket(s): ${ticket_input}
# Short description: ${short_description}
#

EOF

    # Use Git's configured editor
    git_editor=$(git var GIT_EDITOR)
    $git_editor "$temp_file"

    # Read content back, excluding comment lines and empty lines
    long_description=$(grep -v '^#' "$temp_file" | sed -e '/^[[:space:]]*$/d' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')

    # Clean up temp file
    rm "$temp_file"
fi

# Clean up description (replace spaces with hyphens, remove special characters)
# macOS-compatible version using multiple sed commands instead of complex regex
clean_description=$(echo "$short_description" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//')

# Create branch name using first ticket
branch_name="${gituser}/${first_ticket}/${clean_description}"

echo "Creating branch: $branch_name"

# Switch to main and pull latest
git checkout main
git pull origin main

# Create and switch to new branch
git checkout -b "$branch_name"

# Make initial empty commit with formatted message
# Create Jira links for all tickets
jira_links=""
for ticket in "${ticket_numbers[@]}"; do
    if [ -n "$jira_links" ]; then
        jira_links="${jira_links}"
    fi
    jira_links="${jira_links}[${ticket}](https://jetblueairways.atlassian.net/browse/${ticket})  
" #  This is on the next line to foce a carriage return.
done

# Build commit message
if [ -n "$long_description" ]; then
    commit_message="${title_prefix}${short_description}

${jira_links}

${long_description}"
else
    commit_message="${title_prefix}${short_description}

${jira_links}"
fi

git commit --allow-empty -m "$commit_message"

echo "Successfully created and switched to branch: $branch_name"
